{
  "compilerOptions": {
    /* Project structure */
    "rootDir": ".",
    "outDir": "./dist",
    "isolatedModules": true,

    /* Environment */
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",

    /* Type support */
    "types": ["node", "jest"],
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* Output */
    "sourceMap": true,

    /* Strictness */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "src/infrastructure/db/db.ts", "src/infrastructure/mappers/adopter.mapper.ts"],
  "exclude": ["node_modules"]
}